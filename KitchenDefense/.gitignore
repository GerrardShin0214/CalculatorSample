# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / OS
.vs/
.vscode/
.idea/
.gradle/
.DS_Store
Thumbs.db

# Autogenerated VS/MD/Consulo solution and project files (Unity가 만드는 것)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity 밖에서 Core를 테스트하는 dotnet 프로젝트는 커밋한다
!/Tools/**/*.csproj
/Tools/**/bin/
/Tools/**/obj/

# Crash reports / builds / signing keys
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.keystore
*.jks
